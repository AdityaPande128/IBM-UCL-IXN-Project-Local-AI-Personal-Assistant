      },
      "smith": {
        "model": "mlx-community/Qwen2.5-Coder-14B-Instruct-4bit",
        "policy": "transient"
      }
    },
    "measured_gb": {
      "mlx-community/Qwen3-4B-Instruct-2507-4bit": 2.109,
