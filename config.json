  "overlay": {
    "shortcut": "super+shift+j"
  },
  "logs": {
    "dir": "~/.jarvis/logs",
    "max_bytes": 5242880,
    "diagnostics_dir": "~/.jarvis/diagnostics"
  },
  "web": {
    "headless": true,
    "idle_timeout_ms": 120000,
    "navigation_timeout_ms": 20000,
    "action_timeout_ms": 8000,
    "reacquire_ms": 1000,
    "surface": "auto",
